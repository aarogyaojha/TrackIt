{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "tsx": true,
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true,
            "react": {
              "runtime": "automatic"
            }
          }
        }
      }
    ]
  },
  "transformIgnorePatterns": ["node_modules/(?!@nestjs)"]
}
