PORT=4000
MONGODB_URI=mongodb://localhost:27017/trackit?replicaSet=rs0&directConnection=true
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: only required for running `npm run seed:superadmin`
# SUPERADMIN_EMAIL=superadmin@trackit.local
# SUPERADMIN_PASSWORD=SuperSecretAdminPassword123!
